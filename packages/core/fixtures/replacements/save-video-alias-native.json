          "kind": "concrete",
          "types": [
            "core.string"
          ]
        },
        "optional": true
      },
      {
        "role": "output",
        "id": "boolean",
        "type": {
          "kind": "concrete",
          "types": [
            "core.boolean"
          ]
        },
        "optional": true
      }
    ]
  },
