[
  {
    "schemaVersion": 38,
    "nodeType": "dinkster.set_save_target_prefix",
    "version": 1,
    "displayName": "Set Save Target Prefix",
    "category": "utilities/save",
    "description": "Replaces a structured save target's relative prefix while preserving its explicit mount id. The prefix may be linked from a computed string; mount write authority is still checked by the save node at execution.",
    "idempotent": true,
    "interface": [
      {
        "role": "input",
        "id": "target",
        "type": {
          "kind": "concrete",
          "types": [
            "dinkster.save_target"
          ]
        },
        "required": true,
        "widget": {
          "type": "SAVE_TARGET"
        },
        "displayName": "Target and Mount"
      },
      {
        "role": "input",
        "id": "prefix",
        "type": {
          "kind": "concrete",
          "types": [
            "core.string"
          ]
        },
        "required": false,
        "displayName": "Computed Prefix"
      },
      {
        "role": "output",
        "id": "save_target",
        "type": {
          "kind": "concrete",
          "types": [
            "dinkster.save_target"
          ]
        }
      }
    ],
    "searchTerms": [
      "computed save prefix",
      "string to save target",
      "save destination",
      "output path"
    ]
  },
  {
