    "interface": [
      {
        "role": "input",
        "id": "value",
        "type": {
          "kind": "union",
          "types": [
            "core.int",
            "core.float",
            "core.string",
            "core.boolean"
          ]
        },
        "required": true,
        "forceInput": true
      },
      {
        "role": "input",
        "id": "target",
        "type": {
          "kind": "concrete",
          "types": [
            "core.combo"
          ]
