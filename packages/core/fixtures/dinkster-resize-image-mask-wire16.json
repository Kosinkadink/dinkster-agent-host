{
  "schemaVersion": 1,
  "nodeType": "comfy.ResizeImageMaskNode",
  "version": 1,
  "displayName": "Resize Image/Mask",
  "category": "comfy/image/transform",
  "description": "Resize an image or mask using various scaling methods.",
  "idempotent": true,
  "interface": [
    {
      "role": "input",
      "id": "input",
      "type": {
        "kind": "variable",
        "templateId": "input_type",
        "allowed": [
          "comfy.IMAGE",
          "comfy.MASK"
        ]
      },
      "required": true
    },
    {
      "role": "input",
      "id": "scale_method",
      "type": {
        "kind": "concrete",
        "types": [
          "core.combo"
        ]
      },
      "required": false,
      "default": "area",
      "widget": {
        "type": "COMBO",
        "options": [
          "nearest-exact",
          "bilinear",
          "area",
          "bicubic",
          "lanczos"
        ]
      }
    },
    {
      "role": "dynamicCombo",
      "id": "resize_type",
      "options": [
        {
          "key": "scale dimensions",
          "inputs": [
            {
              "role": "input",
              "id": "width",
              "type": {
                "kind": "concrete",
                "types": [
                  "core.int"
                ]
              },
              "required": false,
              "default": 512,
              "doc": "Target width in pixels. Set to 0 to auto-calculate from height while preserving aspect ratio."
            },
            {
              "role": "input",
              "id": "height",
              "type": {
                "kind": "concrete",
                "types": [
                  "core.int"
                ]
              },
              "required": false,
              "default": 512,
              "doc": "Target height in pixels. Set to 0 to auto-calculate from width while preserving aspect ratio."
            },
            {
              "role": "input",
              "id": "crop",
              "type": {
                "kind": "concrete",
                "types": [
                  "core.combo"
                ]
              },
              "required": false,
              "default": "center",
              "widget": {
                "type": "COMBO",
                "options": [
                  "disabled",
                  "center"
                ]
              },
              "doc": "How to handle aspect ratio mismatch: 'disabled' stretches to fit, 'center' crops to maintain aspect ratio."
            }
          ]
        },
        {
          "key": "scale by multiplier",
          "inputs": [
            {
              "role": "input",
              "id": "multiplier",
              "type": {
                "kind": "concrete",
                "types": [
                  "core.float"
                ]
              },
              "required": false,
              "default": 1.0,
              "doc": "Scale factor (e.g., 2.0 doubles size, 0.5 halves size)."
            }
          ]
        },
        {
          "key": "scale longer dimension",
          "inputs": [
            {
              "role": "input",
              "id": "longer_size",
              "type": {
                "kind": "concrete",
                "types": [
                  "core.int"
                ]
              },
              "required": false,
              "default": 512,
              "doc": "The longer edge will be resized to this value. Aspect ratio is preserved."
            }
          ]
        },
        {
          "key": "scale shorter dimension",
          "inputs": [
            {
              "role": "input",
              "id": "shorter_size",
              "type": {
                "kind": "concrete",
                "types": [
                  "core.int"
                ]
              },
              "required": false,
              "default": 512,
              "doc": "The shorter edge will be resized to this value. Aspect ratio is preserved."
            }
          ]
        },
        {
          "key": "scale width",
          "inputs": [
            {
              "role": "input",
              "id": "width",
              "type": {
                "kind": "concrete",
                "types": [
                  "core.int"
                ]
              },
              "required": false,
              "default": 512,
              "doc": "Target width in pixels. Height auto-adjusts to preserve aspect ratio."
            }
          ]
        },
        {
          "key": "scale height",
          "inputs": [
            {
              "role": "input",
              "id": "height",
              "type": {
                "kind": "concrete",
                "types": [
                  "core.int"
                ]
              },
              "required": false,
              "default": 512,
              "doc": "Target height in pixels. Width auto-adjusts to preserve aspect ratio."
            }
          ]
        },
        {
          "key": "scale total pixels",
          "inputs": [
            {
              "role": "input",
              "id": "megapixels",
              "type": {
                "kind": "concrete",
                "types": [
                  "core.float"
                ]
              },
              "required": false,
              "default": 1.0,
              "doc": "Target total megapixels (e.g., 1.0 ~ 1024x1024). Aspect ratio is preserved."
            }
          ]
        },
        {
          "key": "match size",
          "inputs": [
            {
              "role": "input",
              "id": "match",
              "type": {
                "kind": "union",
                "types": [
                  "comfy.IMAGE",
                  "comfy.MASK"
                ]
              },
              "required": true,
              "doc": "Resize input to match the dimensions of this reference image or mask."
            },
            {
              "role": "input",
              "id": "crop",
              "type": {
                "kind": "concrete",
                "types": [
                  "core.combo"
                ]
              },
              "required": false,
              "default": "center",
              "widget": {
                "type": "COMBO",
                "options": [
                  "disabled",
                  "center"
                ]
              },
              "doc": "How to handle aspect ratio mismatch: 'disabled' stretches to fit, 'center' crops to maintain aspect ratio."
            }
          ]
        },
        {
          "key": "scale to multiple",
          "inputs": [
            {
              "role": "input",
              "id": "multiple",
              "type": {
                "kind": "concrete",
                "types": [
                  "core.int"
                ]
              },
              "required": false,
              "default": 8,
              "doc": "Resize so width and height are divisible by this number. Useful for latent alignment (e.g., 8 or 64)."
            }
          ]
        }
      ],
      "required": true,
      "doc": "Select how to resize: by exact dimensions, scale factor, matching another image, etc."
    },
    {
      "role": "output",
      "id": "resized",
      "type": {
        "kind": "variable",
        "templateId": "input_type",
        "allowed": [
          "comfy.IMAGE",
          "comfy.MASK"
        ]
      }
    }
  ],
  "aliases": [
    "ResizeImageMaskNode"
  ],
  "pack": "comfy",
  "signature": "321bd539299a33d45000d3991dcb21aadcebfdbe"
}
